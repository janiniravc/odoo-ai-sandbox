<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odoo_ai_chat_wizard_form" model="ir.ui.view">
        <field name="name">odoo.ai.chat.wizard.form</field>
        <field name="model">odoo.ai.chat.wizard</field>
        <field name="arch" type="xml">
            <form string="Odoo AI Assistant">
                <sheet>
                    <group>
                        <field
                            name="question"
                            string="Ask a question"
                            placeholder="Example: Find AI Tool Demo Customer and show their email and city."
                            nolabel="1"
                        />
                    </group>

                    <div class="text-end">
                        <button
                            name="action_ask_ai"
                            string="Ask AI"
                            type="object"
                            class="btn-primary"
                        />
                    </div>

                    <separator string="AI Response"/>

                    <group>
                        <field
                            name="answer"
                            string=""
                            nolabel="1"
                            readonly="1"
                            placeholder="Your AI response will appear here."
                            class="oe_inline"
                        />
                    </group>
                </sheet>

                <footer>
                    <button
                        string="Close"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>

        </field>
    </record>

    <record id="action_odoo_ai_chat_wizard" model="ir.actions.act_window">
        <field name="name">Odoo AI Assistant</field>
        <field name="res_model">odoo.ai.chat.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_odoo_ai_assistant_root"
        name="AI Assistant"
        sequence="90"
        groups="base.group_user"
    />

    <menuitem
        id="menu_odoo_ai_chat"
        name="Chat"
        parent="menu_odoo_ai_assistant_root"
        action="action_odoo_ai_chat_wizard"
        sequence="10"
        groups="base.group_user"
    />
</odoo>