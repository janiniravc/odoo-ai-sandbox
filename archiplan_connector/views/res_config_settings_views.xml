<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.archiplan</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app name="archiplan_connector" string="ArchiPlan" data-string="ArchiPlan" groups="base.group_system">
                    <block title="ArchiPlan" name="archiplan_settings">
                        <setting string="ArchiPlan URL" help="Base URL for your ArchiPlan workspace.">
                            <field name="archiplan_url" placeholder="https://app.archiplan.io"/>
                        </setting>
                        <setting string="Schedule link" help="Paste the view-only schedule link from ArchiPlan.">
                            <field name="archiplan_schedule_link" placeholder="https://app.archiplan.io/embed/schedule/..."/>
                        </setting>
                        <setting string="Odoo access">
                            <button name="action_create_archiplan_access" type="object" string="Create ArchiPlan access" class="btn-primary"/>
                            <button name="action_revoke_archiplan_access" type="object" string="Revoke ArchiPlan access" class="btn-secondary"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
