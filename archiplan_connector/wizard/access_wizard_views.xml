<odoo>
    <record id="view_archiplan_access_wizard" model="ir.ui.view">
        <field name="name">archiplan.access.wizard.form</field>
        <field name="model">archiplan.access.wizard</field>
        <field name="arch" type="xml">
            <form string="ArchiPlan access">
                <group>
                    <field name="odoo_url" string="Odoo address" widget="CopyClipboardChar"/>
                    <field name="database" widget="CopyClipboardChar"/>
                    <field name="login" widget="CopyClipboardChar"/>
                    <field name="api_key" string="API key" widget="CopyClipboardChar"/>
                    <p>This key is shown only once.</p>
                </group>
                <p>Paste these details in ArchiPlan under Orders → Import → From Odoo.</p>
                <footer><button string="Close" special="cancel" class="btn-primary"/></footer>
            </form>
        </field>
    </record>
</odoo>
